@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@{
    var tokens = Antiforgery.GetAndStoreTokens(Context);
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="request-verification-token" content="@tokens.RequestToken" />
    <title>@ViewData["Title"] - Learn Japanese</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;600;700&display=swap" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" referrerpolicy="no-referrer" />
    <link rel="stylesheet" href="~/css/japanese-theme.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="jl-body-bg d-flex flex-column min-vh-100">
    <header class="sticky-top jl-navbar shadow-sm mb-4">
        <nav class="navbar navbar-expand-lg navbar-dark bg-transparent py-2">
            <div class="container">
                <a class="navbar-brand fw-semibold d-flex align-items-center gap-2" asp-controller="Home" asp-action="Index">
                    <span class="badge rounded-pill jl-flag-pill" aria-hidden="true">日</span>
                    <span>Learn Japanese</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#jlNav" aria-controls="jlNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="jlNav">
                    <ul class="navbar-nav ms-auto mb-2 mb-lg-0 jl-nav-gap">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Update" asp-action="Index">Update Database</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Test" asp-action="English">English Test</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Test" asp-action="Japanese">Japanese Test</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Words" asp-action="Index">View All Words</a>
                        </li>
                        <li class="nav-item d-flex align-items-lg-center mt-3 mt-lg-0">
                            <button type="button" class="btn btn-outline-light btn-sm ms-lg-3" id="jl-theme-toggle" title="Toggle light/dark palette">
                                <span class="jl-theme-light-label">☀ Light</span>
                                <span class="jl-theme-dark-label">🌙 Dark</span>
                            </button>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main class="flex-fill pb-5">
        <div class="container jl-container-shell">
            @RenderBody()
        </div>
    </main>

    <footer class="footer mt-auto py-4 jl-footer border-top">
        <div class="container small text-muted d-flex justify-content-between flex-wrap gap-2">
            <span>&copy; @DateTime.UtcNow.Year Learn Japanese Companion</span>
            <span>Built with ASP.NET Core &amp; EF Core • Practice daily</span>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js" referrerpolicy="no-referrer"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @{
        var toastSuccess = TempData["ToastSuccess"] as string;
        var toastError = TempData["ToastError"] as string;
    }
    @if (!string.IsNullOrEmpty(toastSuccess))
    {
        <script type="text/javascript">
            window.jlToastSuccess = @System.Text.Json.JsonSerializer.Serialize(toastSuccess);
        </script>
    }
    @if (!string.IsNullOrEmpty(toastError))
    {
        <script type="text/javascript">
            window.jlToastError = @System.Text.Json.JsonSerializer.Serialize(toastError);
        </script>
    }
    <script type="text/javascript">
        $(function () {
            if (window.jlToastSuccess) {
                toastr.success(window.jlToastSuccess);
            }
            if (window.jlToastError) {
                toastr.error(window.jlToastError);
            }
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
